# AI Recruitment POC — Backend Environment Variables
# Copy this to .env and fill in your values

# Database (local dev — matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_recruitment
REDIS_URL=redis://localhost:6379

# Copy and edit environment file
cp .env.example .env
# Edit .env — at minimum set OPENAI_API_KEY for production-like runs
# For free local dev: MOCK_EXTERNAL_APIS=true (see MOCK_MODE.md)

# ---------------------------------------------------------------------------
# Mock mode — test without OpenAI / Vapi / LiveKit / Gmail charges
# See backend/MOCK_MODE.md for full guide
# ---------------------------------------------------------------------------
MOCK_EXTERNAL_APIS=false
# Granular overrides (optional; MOCK_EXTERNAL_APIS=true enables all):
# MOCK_OPENAI=true
# MOCK_VAPI=true
# MOCK_LIVEKIT=true
# MOCK_EMAIL=true

# OpenAI
OPENAI_API_KEY=

# Vapi.ai (needed for Sprint 5 — AI voice screening)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Public URL for Vapi webhooks in local dev (e.g. https://abc123.ngrok-free.app)
BACKEND_PUBLIC_URL=

# Sarvam AI (needed for Sprint 5 — Indian language STT/TTS)
SARVAM_API_KEY=

# LiveKit Cloud (needed for Sprint 6 — AI interview)
# LIVEKIT_URL must be wss://your-project.livekit.cloud (candidate WebRTC)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Candidate App URL (used to build interview links)
CANDIDATE_APP_URL=http://localhost:5174
HR_APP_URL=http://localhost:5173

# JWT auth / RBAC
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Optional: seed an admin on startup if no admin exists
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
# Optional: platform superadmin who can manage all organizations
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=superadmin123
SEED_SUPERADMIN_NAME=Super Admin

# Gmail API (interview invitations + rejection emails)
# Place Google OAuth credentials.json in backend/, then run: python -m scripts.gmail_auth
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# File storage
UPLOAD_DIR=uploads/resumes
