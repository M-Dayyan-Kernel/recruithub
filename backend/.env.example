# AI Recruitment POC — Backend Environment Variables
# Copy this to .env and fill in your values

# Database (local dev — matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_recruitment
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=

# Vapi.ai (needed for Sprint 5 — AI voice screening)
VAPI_API_KEY=

# Sarvam AI (needed for Sprint 5 — Indian language STT/TTS)
SARVAM_API_KEY=

# LiveKit Cloud (needed for Sprint 6 — AI interview)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Resend (needed for Sprint 6 — interview link emails)
RESEND_API_KEY=

# File storage
UPLOAD_DIR=uploads/resumes
