# Copy to `.env` for local development. In production inject via secrets manager.

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_recruitment
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins (required when APP_ENV=production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUSTED_HOSTS=

JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
INTEGRATIONS_ENCRYPTION_KEY=
JWT_EXPIRE_MINUTES=480

VAPI_WEBHOOK_SECRET=
BACKEND_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://in-maa-1.linodeobjects.com
S3_REGION=in-maa-1

HR_APP_URL=http://localhost:5173
CANDIDATE_APP_URL=http://localhost:5174

# Email — Resend (optional; used before Gmail when RESEND_API_KEY is set)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Gmail OAuth — inline JSON (preferred in Docker; wrap value in single quotes)
# GMAIL_CREDENTIALS_JSON='{"installed":{"client_id":"...","client_secret":"...",...}}'
# GMAIL_TOKEN_JSON='{"token":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token",...}'
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

SENTRY_DSN=
INTERNAL_HEALTH_API_KEY=

# LLM provider switch: "openai" | "groq" (Groq is OpenAI-compatible)
LLM_PROVIDER=openai
# Groq credentials (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# talentOS backend integration (recruithub -> talentOS internal APIs)
TALENTOS_BE_URL=https://talentos.webknot-dev.in/
TALENTOS_BE_API_KEY=

AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_LOCKOUT_MAX_FAILURES=10
AUTH_LOCKOUT_SECONDS=900

MOCK_EXTERNAL_APIS=false
MOCK_OPENAI=false
MOCK_VAPI=false
MOCK_LIVEKIT=false
MOCK_EMAIL=false

# ── OpenBao (central secrets manager) ─────────────────────────────────────────
# Deployed: api/workers/agent read their secrets from OpenBao at startup
# (secretsSource on /health/ready reports "openbao"). The openbao compose
# service seeds from `seed.env` at the repo root (gitignored, openbao-ONLY) —
# secret values are NEVER written to `.env.production` / this file. Rotate a
# secret: change it in seed.env -> `docker compose up -d openbao` -> restart apps.
#   BAO_ADDR            base URL of OpenBao (empty = skip, use .env only)
#   BAO_TOKEN           inline app token (or set BAO_TOKEN_FILE)
#   BAO_TOKEN_FILE      path to the scoped token file (compose uses /shared/rh.token)
#   BAO_KV_MOUNT        KV v2 secrets engine mount (default "secret")
#   BAO_KV_PATH         per-app folder/namespace (default "recruithub"; "dev" = local)
#   BAO_REQUIRED        "true" = fail startup if no secrets could be fetched
#   BAO_SECRET_KEYS     comma-separated override of which Settings are fetched
# Values seeded: OPENAI_API_KEY, GROQ_API_KEY, VAPI_API_KEY, VAPI_WEBHOOK_SECRET,
# LIVEKIT_API_KEY, LIVEKIT_API_SECRET, S3_ACCESS_KEY, S3_SECRET_KEY,
# GMAIL_CREDENTIALS_JSON, GMAIL_TOKEN_JSON, RESEND_API_KEY, JWT_SECRET_KEY,
# INTEGRATIONS_ENCRYPTION_KEY, TALENTOS_BE_API_KEY, INTERNAL_HEALTH_API_KEY, AIC_API_KEY.
# (Also seeded under the `dev` namespace via DEV_<KEY> overrides in seed.env —
# leave unset to mirror the deployed value.)
#
# ── Local dev via the deployed OpenBao ──────────────────────────────────────
# Real secret values are NOT in this file. Bare uvicorn/celery/agent processes
# (start-dev.ps1) fetch them from the server's OpenBao at boot. Fetch the scoped
# read-only token once from an allowlisted IP:
#   curl -u "$BAO_TOKEN_USER:$BAO_TOKEN_PASS" \
#     https://api.recruithub.webknot-dev.in/bao-token/rh.token -o ~/.recruithub/rh.token
# then point BAO_ADDR/BAO_TOKEN_FILE below at it. Keep non-secret config
# (DATABASE_URL, MOCK_*, CORS) in this file as usual.
#   BAO_ADDR=https://api.recruithub.webknot-dev.in
#   BAO_TOKEN_FILE=C:\Users\<you>\.recruithub\rh.token
#   BAO_KV_PATH=recruithub   # or "dev" for the DEV_* overrides from seed.env
#   BAO_REQUIRED=true
#
# ── OpenBao gateway access (Server 1, in .env.production for deploy.sh) ────
#   BAO_TOKEN_ALLOWED_IPS   space-separated dev IPs/CIDRs (e.g. "1.2.3.4 203.0.113.0/24")
#   BAO_TOKEN_USER          basic-auth user for /bao-token/rh.token
#   BAO_TOKEN_PASS          basic-auth password for /bao-token/rh.token
BAO_ADDR=
BAO_TOKEN=
BAO_TOKEN_FILE=
BAO_KV_MOUNT=secret
BAO_KV_PATH=recruithub
BAO_REQUIRED=false
BAO_SECRET_KEYS=
