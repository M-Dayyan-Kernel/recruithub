# AI Recruitment POC — Backend Environment Variables
# Copy this to .env and fill in your values

# Database (local dev — matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_recruitment
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=

# Vapi.ai (needed for Sprint 5 — AI voice screening)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Public URL for Vapi webhooks in local dev (e.g. https://abc123.ngrok-free.app)
BACKEND_PUBLIC_URL=

# Sarvam AI (needed for Sprint 5 — Indian language STT/TTS)
SARVAM_API_KEY=

# LiveKit Cloud (needed for Sprint 6 — AI interview)
# LIVEKIT_URL must be wss://your-project.livekit.cloud (candidate WebRTC)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Candidate App URL (used to build interview links)
CANDIDATE_APP_URL=http://localhost:5174

# Gmail API (interview invitations + rejection emails)
# Place Google OAuth credentials.json in backend/, then run: python -m scripts.gmail_auth
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# File storage
UPLOAD_DIR=uploads/resumes
