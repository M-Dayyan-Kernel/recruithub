{
  "manifest_version": 3,
  "name": "Recruit Hub Interview Check",
  "version": "0.3.0",
  "description": "Checks locally whether a prohibited AI-assistance extension is enabled before a Recruit Hub interview.",
  "key": "",
  "permissions": [
    "management"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Recruit Hub Interview Check",
    "default_popup": "popup.html"
  }
}
